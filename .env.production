# ============================================================
# SOSLocal Web — Variables de production (Vercel)
# Ce fichier est versionné car il ne contient pas de secrets.
# ============================================================

# Backend FastAPI déployé sur Render — mode réel activé.
NEXT_PUBLIC_MOCK_AUTH=false
NEXT_PUBLIC_API_URL=https://soslocal-backend.onrender.com/api/v1

# URL de l'app (nécessaire pour les métadonnées Open Graph)
NEXT_PUBLIC_APP_URL=https://soslocal-web.vercel.app
