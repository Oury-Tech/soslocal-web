# ============================================================
# SOSLocal Web — Variables d'environnement
# Copier en .env.local et adapter
# ============================================================

# URL du backend FastAPI (laisser vide ou commenter pour mode mock)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# WebSocket
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# API FastAPI côté serveur (proxy BFF)
API_URL=http://localhost:8000/api/v1

# ── MODE MOCK (sans backend) ──────────────────────────────
# Mettre à "true" pour tester sans backend FastAPI
# Les connexions/inscriptions fonctionneront avec des données fictives
NEXT_PUBLIC_MOCK_AUTH=true
